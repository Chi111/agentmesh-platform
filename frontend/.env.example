# Pinme Worker API URL
# Filled automatically by pinme create for first deploy and frontend/.env.

VITE_API_URL="__PINME_VITE_API_URL__"

# Optional unified Web2/Web3 authentication. Leave blank to keep the PinMe
# email/password + Google fallback enabled.
VITE_PRIVY_APP_ID=""
VITE_PRIVY_CLIENT_ID=""

# Verified Ethereum Sepolia test settlement. Use ledger to disable Web3 payment.
VITE_SETTLEMENT_MODE="contract"
VITE_BASE_CHAIN_ID="11155111"
VITE_BASE_CHAIN_NAME="Sepolia"
VITE_BASE_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
VITE_ESCROW_CONTRACT_ADDRESS="0xe05a5e46139294402393e5601d771e6c7564a573"
VITE_ESCROW_DEPLOYMENT_BLOCK="11541034"
VITE_ESCROW_DEPLOYMENT_TX_HASH="0x51bdfc45eb0de5aed4c8cbf63328f4685d67cc81b6f31a67d96b31c16907c80c"
VITE_MUSDC_ADDRESS="0x38A28074C414F94024bc56AA52641DdEdDf17df7"
VITE_USDC_DECIMALS="6"

# Optional production telemetry. Both integrations are lazy-loaded and send
# nothing when their public project keys are blank.
VITE_SENTRY_DSN=""
VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"
